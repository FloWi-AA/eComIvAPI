# Paste these variables into Render Web Service > Environment.
# Do not commit a filled-in copy of this file.

NODE_VERSION=20
BASE_PATH=
VAT_REGEX=^[0-9]{9}$

# Use the Internal Database URL from the Render Postgres instance.
DATABASE_URL=postgresql://<database-user>:<database-password>@<internal-render-host>/<database-name>

# Credentials SKIDATA uses when calling this service.
SKIDATA_BASIC_AUTH_USER=<issued-skidata-username>
SKIDATA_BASIC_AUTH_PASSWORD=<long-random-password>

# Credentials this service uses when posting generated PDFs to SKIDATA.
INVOICEREPORT_BASE_URL=https://sweb.skidata.com/bei/SSP/invoicereport
INVOICEREPORT_AUTH_USER=<issued-reporting-username>
INVOICEREPORT_AUTH_PASSWORD=<issued-reporting-password>
